const svg = d3.select('#map');
const width = 700, height = 620;
const projection = d3.geoMercator().fitSize([width, height], GEO);
const path = d3.geoPath().projection(projection);

const tooltip = document.getElementById('tooltip');
let currentLevel = 'tasa_municipio';
let currentYear = 2026;

const years = Array.from(new Set(Object.values(DATA).flatMap(m => Object.keys(m.anios)))).sort();
const yearSelect = document.getElementById('yearSelect');
years.forEach(y => {
  const opt = document.createElement('option');
  opt.value = y; opt.textContent = y;
  if (+y === currentYear) opt.selected = true;
  yearSelect.appendChild(opt);
});
yearSelect.value = currentYear;

const g = svg.append('g');

const paths = g.selectAll('path')
  .data(GEO.features)
  .join('path')
  .attr('class', 'mun')
  .attr('d', path);

// --- Fronteras gruesas entre regiones/provincias (sin fusionar los municipios) ---
const boundaryGroup = g.append('g').attr('id', 'boundaryOverlay');

function groupKeyFor(level, codigo) {
  const d = DATA[codigo];
  if (!d) return null;
  return level === 'tasa_provincia' ? d.provincia : level === 'tasa_region' ? d.region_salud : null;
}

function computeDissolvedBoundaries(level) {
  const groups = {};
  GEO.features.forEach(f => {
    const key = groupKeyFor(level, f.properties.codigo);
    if (!key) return;
    if (!groups[key]) groups[key] = [];
    groups[key].push(f);
  });
  const outlines = [];
  Object.entries(groups).forEach(([key, feats]) => {
    if (feats.length === 1) { outlines.push(feats[0]); return; }
    try {
      let merged = feats[0];
      for (let i = 1; i < feats.length; i++) {
        const u = turf.union(turf.featureCollection([merged, feats[i]]));
        if (u) merged = u;
      }
      outlines.push(merged);
    } catch (e) {
      feats.forEach(f => outlines.push(f));
    }
  });
  return outlines;
}

const boundaryCache = {};
function renderBoundaries(level) {
  if (level === 'tasa_municipio') {
    boundaryGroup.selectAll('path').remove();
    return;
  }
  if (!boundaryCache[level]) {
    boundaryCache[level] = computeDissolvedBoundaries(level);
  }
  boundaryGroup.selectAll('path')
    .data(boundaryCache[level])
    .join('path')
    .attr('d', path)
    .attr('fill', 'none')
    .attr('stroke', 'var(--navy-deep)')
    .attr('stroke-width', 2)
    .attr('stroke-linejoin', 'round')
    .attr('pointer-events', 'none');
}

function levelLabel(level) {
  return level === 'tasa_municipio' ? 'Municipio' : level === 'tasa_provincia' ? 'Provincia' : 'Región de salud';
}

function render() {
  const values = GEO.features.map(f => {
    const d = DATA[f.properties.codigo];
    return d && d.anios[currentYear] ? d.anios[currentYear][currentLevel] : 0;
  });
  const sortedVals = values.slice().sort((a, b) => a - b);
  const p90Index = Math.floor(sortedVals.length * 0.9);
  const maxV = sortedVals[p90Index] || d3.max(values) || 1;
  const color = d3.scaleSequential(d3.interpolateBlues).domain([0, maxV]).clamp(true);

  paths.attr('fill', f => {
    const d = DATA[f.properties.codigo];
    const v = d && d.anios[currentYear] ? d.anios[currentYear][currentLevel] : 0;
    return color(v);
  });

  document.getElementById('legendMin').textContent = '0';
  document.getElementById('legendMax').textContent = maxV.toFixed(0) + '+ x100k';
  document.getElementById('legendBar').style.background =
    `linear-gradient(90deg, ${color(0)}, ${color(maxV)})`;

  // stat banner: total Cundinamarca
  let totCasos = 0, totPob = 0;
  Object.values(DATA).forEach(m => {
    const a = m.anios[currentYear];
    if (a) { totCasos += a.casos; totPob += a.poblacion; }
  });
  const tasaTotal = (totCasos / totPob * 100000).toFixed(1);
  document.getElementById('statBanner').innerHTML = `
    <div class="stat"><div class="num">${totCasos.toLocaleString('es-CO')}</div><div class="lbl">Casos ${currentYear}</div></div>
    <div class="stat"><div class="num">${totPob.toLocaleString('es-CO')}</div><div class="lbl">Población</div></div>
    <div class="stat"><div class="num">${tasaTotal}</div><div class="lbl">Tasa x 100.000 hab.</div></div>
    <div class="stat"><div class="num" style="font-size:.95rem">${levelLabel(currentLevel)}</div><div class="lbl">Nivel del mapa</div></div>
  `;
}

paths.on('mousemove', function(event, f) {
  const d = DATA[f.properties.codigo];
  const a = d ? d.anios[currentYear] : null;
  if (!d || !a) return;
  tooltip.style.opacity = 1;
  tooltip.style.left = (event.offsetX + 16) + 'px';
  tooltip.style.top = (event.offsetY + 10) + 'px';
  tooltip.innerHTML = `
    <b>${d.municipio}</b>
    <div style="color:#b8c4d0;font-size:.68rem;margin-top:1px">${d.region_salud.charAt(0)+d.region_salud.slice(1).toLowerCase()} · ${d.provincia}</div>
    <div class="row"><span>Casos</span><span>${a.casos}</span></div>
    <div class="row"><span>Población</span><span>${a.poblacion.toLocaleString('es-CO')}</span></div>
    <div class="row"><span>Tasa municipio</span><span>${a.tasa_municipio}</span></div>
    <div class="row"><span>Tasa región salud</span><span>${a.tasa_region}</span></div>
    <div class="row"><span>Tasa provincia</span><span>${a.tasa_provincia}</span></div>
  `;
}).on('mouseleave', () => { tooltip.style.opacity = 0; });

document.getElementById('levelGroup').addEventListener('click', (e) => {
  const btn = e.target.closest('button');
  if (!btn) return;
  document.querySelectorAll('#levelGroup button').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  currentLevel = btn.dataset.level;
  render();
  renderBoundaries(currentLevel);
});

yearSelect.addEventListener('change', () => {
  currentYear = +yearSelect.value;
  render();
});

render();
renderBoundaries(currentLevel);
</script>
