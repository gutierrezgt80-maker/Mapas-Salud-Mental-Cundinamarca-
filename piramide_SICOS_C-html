const ETIQ = {"2025-2026": "2025–2026 (acumulado, 2026 enero–julio)", "2026": "2026 (preliminar enero–julio)", "2025": "2025"};
// ==== PERIODO QUE SE MUESTRA AL ABRIR ====
let cur = PER[0];
const $ = id => document.getElementById(id);
const fmt = n => Math.round(n).toLocaleString('es-CO');
const dec = x => x.toLocaleString('es-CO',{minimumFractionDigits:1,maximumFractionDigits:1});
const dec2 = x => x.toLocaleString('es-CO',{minimumFractionDigits:2,maximumFractionDigits:2});
PER.forEach(p=>{const o=document.createElement('option');o.value=p;o.textContent=ETIQ[p]||p;if(p===cur)o.selected=true;$('per').appendChild(o);});
(function(){const t=$('terr');const o=document.createElement('option');o.value='D';o.textContent='Cundinamarca';t.appendChild(o);
 const pref={'Regiones de salud':'R|','Provincias':'P|','Municipios':'M|'};
 Object.entries(TERR).forEach(([g,l])=>{const og=document.createElement('optgroup');og.label=g;l.forEach(n=>{const o=document.createElement('option');o.value=pref[g]+n;o.textContent=n;og.appendChild(o);});t.appendChild(og);});})();
function val(per,terr,sx,g){const a=(((D[per]||{})[terr]||{})[sx]||{})[g];return a?a:[0,0,0,0,0,0];}
function trap(y0,y1,cx,ytop,yb,half){const w=y=>half*(y-ytop)/(yb-ytop);return `${cx-w(y0)},${y0} ${cx+w(y0)},${y0} ${cx+w(y1)},${y1} ${cx-w(y1)},${y1}`;}
function banda(y0,y1,fill,txt,col,titulo,num){const cy=y0<20?y0+(y1-y0)*0.72:(y0+y1)/2;return `<polygon points="${trap(y0,y1,210,10,352,205)}" fill="${fill}"/>
  <text x="210" y="${cy-2}" text-anchor="middle" font-size="${titulo.length>24?13:15}" font-weight="700" fill="${txt}">${titulo}</text>
  <text x="210" y="${cy+17}" text-anchor="middle" font-size="14" fill="${col}">${num}</text>`;}
function render(){
  const p=$('per').value, t=$('terr').value, sx=$('sex').value, g=$('edad').value, det=$('det').checked;
  const [m,i,ie,ine,pob,prev]=val(p,t,sx,g); const id=ie+ine; const ref=val(p,'D',sx,g);
  let s;
  if(!det){ s = banda(10,118,'#1b3a5c','#fff','#fff','Muertes',fmt(m)) + banda(124,232,'#4f86b8','#fff','#fff','Intentos notificados',fmt(i))
              + banda(238,352,'#c6dcef','#12283f','#12283f','Ideación suicida',fmt(id)); }
  else { s = banda(10,104,'#1b3a5c','#fff','#fff','Muertes',fmt(m)) + banda(110,190,'#4f86b8','#fff','#fff','Intentos notificados',fmt(i))
              + banda(196,268,'#9cc3e6','#12283f','#12283f','Ideación estructurada',fmt(ie)) + banda(274,352,'#d6e6f4','#12283f','#12283f','Ideación no estructurada',fmt(ine)); }
  $('pyr').innerHTML = s;
  $('rzi').textContent = m ? dec(i/m) : '—'; $('rzd').textContent = m ? dec(id/m) : '—';
  $('rzref').textContent = t==='D' ? '' : `Cundinamarca: ${ref[0]?dec(ref[1]/ref[0]):'—'} intentos y ${ref[0]?dec((ref[2]+ref[3])/ref[0]):'—'} ideaciones por muerte`;
  $('aviso').style.display = (m<5) ? 'block' : 'none';
  $('aviso').textContent = m===0 ? 'Sin muertes en esta selección: no se puede calcular la razón por muerte.' : 'Pocas muertes en esta selección: las razones son inestables, interpretar con cautela.';
  const H=val(p,t,'Hombre',g), M=val(p,t,'Mujer',g);
  const tasa=c=>pob>0?dec2(c/pob*100000):'—'; const pc=(a,b)=>b?dec(100*a/b)+'%':'—';
  $('cmp').innerHTML=`<div class="n"><span>Tasa de muerte (DANE)</span><b>${tasa(m)}</b><span>por 100.000 hab.</span></div>
   <div class="n"><span>Tasa de intento (356)</span><b>${tasa(i)}</b><span>por 100.000 hab.</span></div>
   <div class="i"><span>Ideaciones por intento</span><b>${i?dec(id/i):'—'}</b><span>casos notificados (no es tasa)</span></div>
   <div class="i"><span>Ideación estructurada</span><b>${pc(ie,id)}</b><span>de la ideación notificada</span></div>
   <div><span>Muertes en hombres</span><b>${pc(H[0],H[0]+M[0])}</b><span>del total de muertes</span></div>
   <div><span>Intentos en mujeres</span><b>${pc(M[1],H[1]+M[1])}</b><span>del total de intentos</span></div>
   <div><span>Ideación en mujeres</span><b>${pc(M[2]+M[3],H[2]+H[3]+M[2]+M[3])}</b><span>del total de ideación</span></div>
   <div><span>Intentos con intento previo</span><b>${pc(prev,i)}</b><span>de los intentos notificados</span></div>`;
}
['per','terr','sex','edad','det'].forEach(id=>$(id).addEventListener('change',render));
render();
</script></body></html>
